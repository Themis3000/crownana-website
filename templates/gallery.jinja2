<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Gallery Home</title>
    <link rel="stylesheet" href="/resources/styles.css">
</head>
<body>
    <h1 id="photography-header">Crownana Photography</h1>
    <div id="tabs">
        {% for category_info in categories_info %}
            <a class="{{ 'tab-item tab-selected' if category_info['name'] == selected_category else 'tab-item' }}" href="{{ category_info['href'] }}">{{ category_info["name"] }}</a>
        {% endfor %}
    </div>
    <div id="photos">
        {% for img_entry in img_entries %}
            <div class="gallery-photo-entry">
                <a href="/resources/gallery/{{ img_entry['path'] }}">
                    <img src="/resources/gallery/thumbs/{{ img_entry['path'] }}" class="gallery-photo" alt="{{ img_entry['alt'] }}">
                </a>
                <a {{ ("href='/gallery/pages/" + img_entry['info_page'] + "'") if 'info_page' in img_entry else '' }}>
                    {{ img_entry['subtext'] }}
                </a>
            </div>
        {% endfor %}
    </div>
    <script src="/resources/scripts/common.js"></script>
    <script src="/resources/scripts/gallery.js"></script>
</body>
</html>