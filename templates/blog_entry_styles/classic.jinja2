<div class="blog_entry blog_entry_frame_classic stamp" style="background: {{ blog_entry.entry_meta['color_theme'] }}">
    <a href="{{ blog_entry.get_url_path() }}">
        <h3 class="blog_entry_title">{{ blog_entry.title }}</h3>
    </a>
    <p class="blog_entry_teaser">{{ blog_entry.teaser }}</p>
    <div class="blog_entry_date">({{ blog_entry.date }})</div>
</div>